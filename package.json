{
  "name": "justavps-tmp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev/dev-stack.sh",
    "dev:next": "next dev --webpack -p 4100",
    "dev:turbopack": "next dev -p 4100",
    "dev:ngrok": "bash scripts/dev/dev-with-ngrok-callback.sh",
    "dev:stripe": "bash scripts/dev/dev-with-stripe.sh",
    "callback:ngrok": "bash scripts/dev/dev-ngrok-callback.sh start",
    "callback:ngrok:url": "bash scripts/dev/dev-ngrok-callback.sh url",
    "callback:ngrok:doctor": "bash scripts/dev/dev-ngrok-callback.sh doctor",
    "callback:ngrok:stop": "bash scripts/dev/dev-ngrok-callback.sh stop",
    "dev:all": "docker rm -f justavps-postgres 2>/dev/null; docker compose up -d postgres && pnpm run db:push && bash scripts/dev/dev-with-stripe.sh",
    "v1api:dev": "tsx --tsconfig tsconfig.json apps/v1-api/src/index.ts",
    "v1api:start": "tsx --tsconfig tsconfig.json apps/v1-api/src/index.ts",
    "v1api:typecheck": "tsc -p apps/v1-api/tsconfig.json --noEmit",
    "dev:split": "V1_API_URL=${V1_API_URL:-http://localhost:4101} pnpm v1api:dev & pnpm dev",
    "runnerd:build": "pnpm exec tsc -p apps/runnerd/tsconfig.json",
    "runnerd:dev": "tsx apps/runnerd/src/index.ts",
    "v2api:build": "pnpm admin:build && pnpm --dir apps/v2-api build",
    "v2api:db:generate": "pnpm --dir apps/v2-api db:generate",
    "v2api:db:migrate": "pnpm --dir apps/v2-api db:migrate",
    "v2api:dev": "pnpm --dir apps/v2-api dev",
    "admin:install": "pnpm --dir apps/admin-web install",
    "admin:dev": "pnpm --dir apps/admin-web dev",
    "admin:build": "pnpm --dir apps/admin-web build",
    "admin:typecheck": "pnpm --dir apps/admin-web typecheck",
    "control-plane:worker": "tsx scripts/ops/control-plane-worker.ts",
    "stripe:listen": "stripe listen --forward-to http://localhost:4100/api/v1/stripe/webhooks --events checkout.session.completed,invoice.payment_failed,customer.subscription.deleted,customer.subscription.updated",
    "db:push": "drizzle-kit push",
    "db:seed:templates": "tsx scripts/ops/seed-base-image.ts",
    "deploy:prepare": "pnpm db:push && pnpm db:seed:templates",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "e2e:v1:ui": "playwright test tests/e2e/e2e/01-landing.spec.ts tests/e2e/e2e/02-auth.spec.ts tests/e2e/e2e/03-machines.spec.ts tests/e2e/e2e/04-provision-wizard.spec.ts tests/e2e/e2e/05-settings.spec.ts tests/e2e/e2e/06-navigation.spec.ts tests/e2e/e2e/07-machine-detail.spec.ts tests/e2e/e2e/08-proxy-auth.spec.ts tests/e2e/e2e/09-account-org.spec.ts tests/e2e/e2e/10-account-invite-redeem.spec.ts tests/e2e/e2e/11-account-resource-scope.spec.ts tests/e2e/e2e/12-account-proxy-billing.spec.ts",
    "e2e:v1:billing": "tsx -r dotenv/config tests/scripts/v1/e2e-billing.ts",
    "e2e:v1:direct-checkout": "tsx -r dotenv/config tests/scripts/v1/e2e-direct-checkout.ts",
    "e2e:v1:full-live": "bash tests/scripts/v1/e2e-full.sh",
    "e2e:v1:proxy": "bash tests/scripts/v1/e2e-proxy.sh",
    "e2e:v1:toolbox-api": "bash tests/scripts/v1/e2e-toolbox-api.sh",
    "e2e:v1:toolbox": "bash tests/scripts/v1/e2e-toolbox.sh",
    "e2e:v1:legacy-runner": "bash tests/scripts/v1/run-e2e.sh",
    "e2e:v1:all": "bash tests/scripts/v1/run-all.sh",
    "e2e:v2api:01": "bash tests/scripts/v2-api/01-health-and-inventory.sh",
    "e2e:v2api:02": "bash tests/scripts/v2-api/02-inventory-and-cluster-sync.sh",
    "e2e:v2api:03": "bash tests/scripts/v2-api/03-machine-lifecycle.sh",
    "e2e:v2api:04": "bash tests/scripts/v2-api/04-snapshots-images-backups.sh",
    "e2e:v2api:05": "bash tests/scripts/v2-api/05-vm-lifecycle.sh",
    "e2e:v2api:06": "bash tests/scripts/v2-api/06-contract-and-cleanup.sh",
    "e2e:v2api:07": "bash tests/scripts/v2-api/07-auth-and-negative-paths.sh",
    "e2e:v2api:08": "bash tests/scripts/v2-api/08-procurement-and-bootstrap.sh",
    "e2e:v2api:ui": "playwright test tests/e2e/v2-api-admin.spec.ts --config playwright.v2-api.config.ts",
    "e2e:v2api:core": "pnpm e2e:v2api:01 && pnpm e2e:v2api:02 && pnpm e2e:v2api:03 && pnpm e2e:v2api:04 && pnpm e2e:v2api:05 && pnpm e2e:v2api:07 && pnpm e2e:v2api:08 && pnpm e2e:v2api:06",
    "benchmark:runner-startup": "tsx -r dotenv/config tests/benchmarks/runner-startup-benchmark.ts",
    "benchmark:direct-incus-container": "tsx -r dotenv/config tests/benchmarks/direct-incus-container-bench.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hono/node-server": "^1.19.11",
    "@hono/zod-openapi": "^1.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@react-three/fiber": "^9.5.0",
    "@scalar/hono-api-reference": "^0.10.3",
    "@tanstack/react-query": "^5.90.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "jose": "^6.2.1",
    "lucide-react": "^0.577.0",
    "mailtrap": "^4.5.1",
    "nanoid": "^5.1.7",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "shadcn": "^4.0.8",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
