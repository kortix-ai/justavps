{
  "name": "justavps-tmp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 4100",
    "dev:turbopack": "next dev -p 4100",
    "dev:ngrok": "bash scripts/dev/dev-with-ngrok-callback.sh",
    "dev:stripe": "bash scripts/dev/dev-with-stripe.sh",
    "callback:ngrok": "bash scripts/dev/dev-ngrok-callback.sh start",
    "callback:ngrok:url": "bash scripts/dev/dev-ngrok-callback.sh url",
    "callback:ngrok:doctor": "bash scripts/dev/dev-ngrok-callback.sh doctor",
    "callback:ngrok:stop": "bash scripts/dev/dev-ngrok-callback.sh stop",
    "dev:all": "docker rm -f justavps-postgres 2>/dev/null; docker compose up -d postgres && pnpm run db:push && bash scripts/dev/dev-with-stripe.sh",
    "runnerd:build": "pnpm exec tsc -p apps/runnerd/tsconfig.json",
    "runnerd:dev": "tsx apps/runnerd/src/index.ts",
    "control-plane:worker": "tsx scripts/ops/control-plane-worker.ts",
    "stripe:listen": "stripe listen --forward-to http://localhost:4100/api/v1/stripe/webhooks --events checkout.session.completed,invoice.payment_failed,customer.subscription.deleted,customer.subscription.updated",
    "db:push": "drizzle-kit push",
    "db:seed:templates": "tsx scripts/ops/seed-base-image.ts",
    "deploy:prepare": "pnpm db:push && pnpm db:seed:templates",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sdk:generate": "tsx scripts/ops/fetch-openapi.ts && npx @hey-api/openapi-ts && openapi-python-client generate --path src/sdk/openapi.json --output-path src/sdk/python --overwrite",
    "sdk:generate:ts": "tsx scripts/ops/fetch-openapi.ts && npx @hey-api/openapi-ts",
    "sdk:generate:python": "tsx scripts/ops/fetch-openapi.ts && openapi-python-client generate --path src/sdk/openapi.json --output-path src/sdk/python --overwrite",
    "sdk:check": "pnpm sdk:generate && git diff --exit-code src/sdk/",
    "e2e:v1:ui": "playwright test tests/e2e/e2e/01-landing.spec.ts tests/e2e/e2e/02-auth.spec.ts tests/e2e/e2e/03-machines.spec.ts tests/e2e/e2e/04-provision-wizard.spec.ts tests/e2e/e2e/05-settings.spec.ts tests/e2e/e2e/06-navigation.spec.ts tests/e2e/e2e/07-machine-detail.spec.ts tests/e2e/e2e/08-proxy-auth.spec.ts tests/e2e/e2e/09-account-org.spec.ts tests/e2e/e2e/10-account-invite-redeem.spec.ts tests/e2e/e2e/11-account-resource-scope.spec.ts tests/e2e/e2e/12-account-proxy-billing.spec.ts",
    "e2e:v1:billing": "tsx -r dotenv/config tests/scripts/v1/e2e-billing.ts",
    "e2e:v1:direct-checkout": "tsx -r dotenv/config tests/scripts/v1/e2e-direct-checkout.ts",
    "e2e:v1:full-live": "bash tests/scripts/v1/e2e-full.sh",
    "e2e:v1:proxy": "bash tests/scripts/v1/e2e-proxy.sh",
    "e2e:v1:toolbox-api": "bash tests/scripts/v1/e2e-toolbox-api.sh",
    "e2e:v1:toolbox": "bash tests/scripts/v1/e2e-toolbox.sh",
    "e2e:v1:legacy-runner": "bash tests/scripts/v1/run-e2e.sh",
    "e2e:v1:all": "bash tests/scripts/v1/run-all.sh",
    "e2e:v2:01:topology": "tsx -r dotenv/config tests/scripts/v2/01-region-cluster-host-foundation.ts",
    "e2e:v2:02:placement": "tsx -r dotenv/config tests/scripts/v2/02-placement-and-capacity.ts",
    "e2e:v2:03:container": "tsx -r dotenv/config tests/scripts/v2/03-create-machine-container.ts",
    "e2e:v2:04:baremetal-lifecycle": "tsx -r dotenv/config tests/scripts/v2/04-baremetal-lifecycle.ts",
    "e2e:v2:05:procurement": "tsx -r dotenv/config tests/scripts/v2/05-capacity-and-procurement.ts",
    "e2e:v2:06:dashboard": "playwright test tests/e2e/e2e/14-v2-admin-fleet.spec.ts",
    "e2e:v2:07:host-bootstrap-validation": "tsx -r dotenv/config tests/scripts/v2/07-host-bootstrap-validation.ts",
    "e2e:v2:08:external-proxy-daemon": "tsx -r dotenv/config tests/scripts/v2/08-external-proxy-daemon.ts",
    "e2e:v2:09:ui-machines": "playwright test tests/e2e/e2e/13-v2-flow.spec.ts tests/e2e/e2e/15-v2-machines-ui.spec.ts",
    "e2e:v2:10:ui-images": "playwright test tests/e2e/e2e/16-v2-images-ui.spec.ts",
    "e2e:v2:11:ui-billing": "playwright test tests/e2e/e2e/17-v2-billing-ui.spec.ts",
    "e2e:v2:12:ui-admin": "playwright test tests/e2e/e2e/18-v2-admin-panel.spec.ts",
    "v2:inventory": "tsx -r dotenv/config scripts/ops/v2-inventory.ts",
    "v2:reset:dry": "tsx -r dotenv/config scripts/ops/v2-reset.ts",
    "v2:reset": "tsx -r dotenv/config scripts/ops/v2-reset.ts --apply",
    "v2:sim": "tsx -r dotenv/config scripts/ops/runnerd-sim.ts",
    "v2:seed:dev": "tsx -r dotenv/config scripts/ops/v2-seed-dev-host.ts",
    "v2:register:prod": "tsx scripts/ops/v2-register-prod-hosts.ts",
    "v2:register:prod:rotate": "tsx scripts/ops/v2-register-prod-hosts.ts --rotate",
    "e2e:v2:db-only": "pnpm e2e:v2:01:topology && pnpm e2e:v2:02:placement && pnpm e2e:v2:05:procurement && pnpm e2e:v2:07:host-bootstrap-validation",
    "e2e:v2:fresh": "bash scripts/ops/v2-fresh.sh",
    "e2e:v2:core": "pnpm e2e:v2:01:topology && pnpm e2e:v2:02:placement && pnpm e2e:v2:03:container && pnpm e2e:v2:04:baremetal-lifecycle && pnpm e2e:v2:05:procurement && pnpm e2e:v2:07:host-bootstrap-validation && pnpm e2e:v2:08:external-proxy-daemon",
    "e2e:v2:ui": "pnpm e2e:v2:06:dashboard && pnpm e2e:v2:09:ui-machines && pnpm e2e:v2:10:ui-images && pnpm e2e:v2:11:ui-billing && pnpm e2e:v2:12:ui-admin",
    "e2e:v2:all": "pnpm e2e:v2:core && pnpm e2e:v2:ui",
    "cli:v2": "tsx src/cli/v2.ts",
    "e2e:v2:cold": "tsx -r dotenv/config tests/benchmarks/e2e-v2-cold-benchmark.ts",
    "e2e:v2:startup-benchmark": "tsx -r dotenv/config tests/benchmarks/e2e-v2-startup-benchmark.ts",
    "benchmark:runner-startup": "tsx -r dotenv/config tests/benchmarks/runner-startup-benchmark.ts",
    "benchmark:direct-incus-container": "tsx -r dotenv/config tests/benchmarks/direct-incus-container-bench.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hono/node-server": "^1.19.11",
    "@hono/zod-openapi": "^1.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@react-three/fiber": "^9.5.0",
    "@scalar/hono-api-reference": "^0.10.3",
    "@tanstack/react-query": "^5.90.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "jose": "^6.2.1",
    "lucide-react": "^0.577.0",
    "mailtrap": "^4.5.1",
    "nanoid": "^5.1.7",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "shadcn": "^4.0.8",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.94.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
