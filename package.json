{
  "name": "justavps-tmp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4100",
    "dev:stripe": "bash scripts/dev-with-stripe.sh",
    "dev:all": "docker rm -f justavps-postgres 2>/dev/null; docker compose up -d postgres && pnpm run db:push && bash scripts/dev-with-stripe.sh",
    "stripe:listen": "stripe listen --forward-to http://localhost:4100/api/v1/stripe/webhooks --events checkout.session.completed,invoice.payment_failed,customer.subscription.deleted,customer.subscription.updated",
    "db:push": "drizzle-kit push",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sdk:generate": "tsx scripts/fetch-openapi.ts && npx @hey-api/openapi-ts && openapi-python-client generate --path src/sdk/openapi.json --output-path src/sdk/python --overwrite",
    "sdk:generate:ts": "tsx scripts/fetch-openapi.ts && npx @hey-api/openapi-ts",
    "sdk:generate:python": "tsx scripts/fetch-openapi.ts && openapi-python-client generate --path src/sdk/openapi.json --output-path src/sdk/python --overwrite",
    "sdk:check": "pnpm sdk:generate && git diff --exit-code src/sdk/",
    "e2e:billing": "tsx -r dotenv/config scripts/e2e-billing.ts",
    "e2e:direct-checkout": "tsx -r dotenv/config scripts/e2e-direct-checkout.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource/inter": "^5.2.8",
    "@hono/node-server": "^1.19.11",
    "@hono/zod-openapi": "^1.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@scalar/hono-api-reference": "^0.10.3",
    "@tanstack/react-query": "^5.90.21",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "hono-openapi": "^1.3.0",
    "jose": "^6.2.1",
    "lucide-react": "^0.577.0",
    "mailtrap": "^4.5.1",
    "motion": "^12.38.0",
    "nanoid": "^5.1.7",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "shadcn": "^4.0.8",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.94.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
