# JustAVPS Environment Variables
# Copy this to .env and fill in your values.
#
# Branches & deployments:
#   main       → dev.justavps.com
#   production → justavps.com
#
# For local real-host E2E, prefer `pnpm callback:ngrok` or `pnpm dev:ngrok`
# so MACHINE_CALLBACK_URL is written to `.env.local` with a public callback URL.

NEXT_PUBLIC_DEV_MODE=true

# -----------------------------------------------------------------------------
# Cloud provider / dedicated hosts
# -----------------------------------------------------------------------------
HETZNER_API_KEY=
HETZNER_DEFAULT_LOCATION=hel1
HETZNER_DEFAULT_SERVER_TYPE=cx22
HETZNER_BASE_SNAPSHOT_ID=

HETZNER_ROBOT_USER=
HETZNER_ROBOT_PASSWORD=

BAREMETAL_ENABLED=true
BAREMETAL_PURCHASE_APPROVAL_REQUIRED=true
BAREMETAL_BOOTSTRAP_PUBLIC_KEY=
BAREMETAL_BOOTSTRAP_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Cloudflare (DNS + KV + Worker auth)
# -----------------------------------------------------------------------------
CLOUDFLARE_GLOBAL_API_KEY=
CLOUDFLARE_EMAIL=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/justavps?sslmode=require
TEST_DATABASE_URL=postgresql://postgres:bench@127.0.0.1:18150/justavps?sslmode=disable
DB_SSL=true
DB_MAX_CONNECTIONS=5
DB_IDLE_TIMEOUT_SECONDS=20
DB_MAX_LIFETIME_SECONDS=1800
DB_APPLICATION_NAME=justavps-api

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Encryption / auth / proxy signing
# -----------------------------------------------------------------------------
DATA_ENCRYPTION_KEY=
AUTH_SECRET=
PROXY_AUTH_SECRET=

# -----------------------------------------------------------------------------
# GitHub OAuth (optional)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_URL=https://justavps.com

# -----------------------------------------------------------------------------
# Mail / notifications
# -----------------------------------------------------------------------------
MAILTRAP_API_TOKEN=
MAILTRAP_USE_SANDBOX=false
MAILTRAP_INBOX_ID=
MAILTRAP_SENDER_EMAIL=justavps@kortix.ai
MAILTRAP_SENDER_NAME=JustAVPS

# -----------------------------------------------------------------------------
# Platform / proxy / broker / daemon
# -----------------------------------------------------------------------------
PLATFORM_URL=https://justavps.com
MACHINE_CALLBACK_URL=https://justavps.com
PROXY_DOMAIN=kortix.cloud
NEXT_PUBLIC_PROXY_DOMAIN=kortix.cloud
NEXT_PUBLIC_APP_URL=https://justavps.com
NEXT_PUBLIC_API_URL=https://justavps.com/api
# Deprecated direct platform proxy remains available only as an emergency rollback.
# Leave this disabled unless you explicitly need the legacy /api/v1/machines/:id/proxy path.
LEGACY_PLATFORM_PROXY_ENABLED=false
# v2 API + dashboard are gated behind this flag.
#   DEFAULT = false in every environment (dev, preview, prod). Fail-closed so
#   that a deploy can never accidentally expose /api/v2/* or /v2/* pages.
#   Set BOTH to true to enable v2. Prod stays v1-only until v2 is ready to ship
#   (hundreds of live machines depend on the v1 contract).
# NEXT_PUBLIC_FEATURE_V2_ENABLED must match FEATURE_V2_ENABLED; it's read by
# middleware + client-side code that can't access server-only env vars.
FEATURE_V2_ENABLED=false
NEXT_PUBLIC_FEATURE_V2_ENABLED=false
BROKER_HOST=
BROKER_IPV4=
BROKER_IPV6=
BROKER_SHARED_SECRET=
DAEMON_CHANNEL=latest
DAEMON_DESIRED_VERSION=
DAEMON_DOWNLOAD_URL=
CONTROL_PLANE_RUNTIME_DISABLED=false

# -----------------------------------------------------------------------------
# Local dev / ngrok helpers
# -----------------------------------------------------------------------------
NGROK_RESERVED_URL=
NGROK_URL=
NGROK_LOG_FILE=/tmp/justavps-ngrok-callback.log
NGROK_CONFIG_PATH=
NGROK_KILL_OTHER_LOCAL_AGENTS=1

# -----------------------------------------------------------------------------
# Optional docs / platform integrations
# -----------------------------------------------------------------------------
JUSTAVPS_API_KEY=

KORTIX_OAUTH_CLIENT_ID=
KORTIX_OAUTH_CLIENT_SECRET=
KORTIX_OAUTH_BASE_URL=https://api.computer.kortix.com/v1/oauth
KORTIX_FRONTEND_URL=https://computer.kortix.com

# -----------------------------------------------------------------------------
# Worker / broker notes
# -----------------------------------------------------------------------------
# The Cloudflare Worker also needs:
#   PROXY_AUTH_SECRET
#   BROKER_SHARED_SECRET
# set via `wrangler secret put`.
#
# Bare-metal hosts / runnerd typically need:
#   RUNNERD_TOKEN
#   RUNNERD_PORT=7779
#   RUNNERD_PUBLIC_IPV4=<host-ip>
#   RUNNERD_PUBLIC_IPV6=
#   POOL_CPU_BUCKETS=1,2
#   WARM_POOL_PER_CPU=1
