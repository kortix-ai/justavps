# JustAVPS Environment Variables
# Copy this to .env and fill in your values

# Hetzner Cloud
HETZNER_API_KEY=
HETZNER_DEFAULT_LOCATION=nbg1
HETZNER_DEFAULT_SERVER_TYPE=cx22

# Cloudflare (DNS + KV — no tunnels)
CLOUDFLARE_GLOBAL_API_KEY=
CLOUDFLARE_EMAIL=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=  # KV namespace for the proxy Worker

# Database (Neon)
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COMPUTE_PRODUCT_ID=

# Auth (NextAuth v5 + GitHub OAuth)
# Create at: https://github.com/settings/applications/new
# Callback URL: https://justavps.com/api/auth/callback/github
AUTH_SECRET=   # run: openssl rand -base64 32
PROXY_AUTH_SECRET=  # Shared with CF Worker. run: openssl rand -base64 32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_URL=https://justavps.com

# Platform
PLATFORM_URL=https://justavps.com
PROXY_DOMAIN=kortix.cloud
NEXT_PUBLIC_APP_URL=https://justavps.com
NEXT_PUBLIC_API_URL=https://justavps.com/api

# Compute pricing markup
COMPUTE_MARKUP=2.5
