# JustAVPS Environment Variables
# Copy this to .env and fill in your values
#
# Branches & deployments:
#   main       → dev.justavps.com    (development)
#   production → justavps.com         (live)
#
# For dev: use Stripe test keys (sk_test_...) and a separate GitHub OAuth app
# with callback URL https://dev.justavps.com/api/auth/callback/github

NEXT_PUBLIC_DEV_MODE=true

# ─── Cloud Provider ──────────────────────────────────────────────────────────
HETZNER_API_KEY=
HETZNER_DEFAULT_LOCATION=nbg1                     # EU or US region
HETZNER_DEFAULT_SERVER_TYPE=cx22
HETZNER_BASE_SNAPSHOT_ID=                          # Pre-built snapshot for fast boot (~5s vs ~100s)

# ─── Cloudflare (DNS + KV — no tunnels) ──────────────────────────────────────
CLOUDFLARE_GLOBAL_API_KEY=
CLOUDFLARE_EMAIL=
CLOUDFLARE_ZONE_ID=                                # Zone ID for PROXY_DOMAIN
CLOUDFLARE_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=                                # KV namespace for proxy Worker

# ─── Database (Neon) ─────────────────────────────────────────────────────────
DATABASE_URL=                                      # postgres://user:pass@host/db?sslmode=require

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                                 # prod: sk_live_... | dev: sk_test_...
STRIPE_WEBHOOK_SECRET=                             # From Stripe webhook endpoint settings

# ─── Auth (NextAuth v5 + GitHub OAuth) ───────────────────────────────────────
AUTH_SECRET=                                       # openssl rand -base64 32
PROXY_AUTH_SECRET=                                 # Shared with CF Worker. MUST be identical across all envs (dev+prod). openssl rand -base64 32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_URL=https://justavps.com                  # dev: https://dev.justavps.com

# ─── Email (Mailtrap) ───────────────────────────────────────────────────────
MAILTRAP_API_TOKEN=
MAILTRAP_USE_SANDBOX=false                         # true for dev to avoid sending real emails
MAILTRAP_INBOX_ID=                                 # Required when USE_SANDBOX=true
MAILTRAP_SENDER_EMAIL=justavps@kortix.ai
MAILTRAP_SENDER_NAME=JustAVPS

# ─── Platform ────────────────────────────────────────────────────────────────
PLATFORM_URL=https://justavps.com                  # dev: https://dev.justavps.com
PROXY_DOMAIN=kortix.cloud                          # Shared across environments
NEXT_PUBLIC_APP_URL=https://justavps.com           # dev: https://dev.justavps.com
NEXT_PUBLIC_API_URL=https://justavps.com/api       # dev: https://dev.justavps.com/api
DAEMON_CHANNEL=latest                              # dev: "dev" (downloads from daemon/dev/latest/ on R2)

# ─── Pricing ─────────────────────────────────────────────────────────────────
COMPUTE_MARKUP=2.5                               

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


